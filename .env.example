# GEMINI_API_KEY: Requerido para la generación de copys con IA (Google AI Studio)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: URL base pública donde se despliega la aplicación (Vercel / Cloud Run)
APP_URL="https://mi-suite-kase.vercel.app"

# BASE DE DATOS EXTERNA (PostgreSQL / Supabase)
DATABASE_URL="postgresql://postgres:password@db.xxx.supabase.co:5432/postgres"
SUPABASE_ANON_KEY="eyJhbGciOi..."

# MERCADO PAGO URUGUAY (Cobros reales y suscripciones en producción)
MERCADO_PAGO_ACCESS_TOKEN="APP_USR-..."
MERCADO_PAGO_PUBLIC_KEY="APP_USR-..."

# MÓDULO 2: X / TWITTER API v2 (Sindicación autónoma de hilos)
TWITTER_API_KEY="xxx"
TWITTER_API_SECRET="xxx"
TWITTER_ACCESS_TOKEN="xxx"
TWITTER_ACCESS_SECRET="xxx"

# MÓDULO 4: OUTBOUND SOCIAL LISTENING & Q&A BLINDADO (X/Twitter & Foros Q&A con Anti-Ban Guard)
# Emplea las credenciales de Twitter API v2 (TWITTER_API_KEY) o webhooks seguros de difusión sin riesgo de baneo.
OUTBOUND_SAFE_DISPATCH_TOKEN="kase_outbound_safe_token"

# MÓDULO 1: GOOGLE SEARCH INDEXING API (Indexación forzada y rastreo en Google)
# Ingrese el JSON de la cuenta de servicio de Google Search Console en una sola línea
GOOGLE_SERVICE_ACCOUNT_JSON="{\"type\":\"service_account\",\"project_id\":\"...\"}"
