{
  "version": 2,
  "crons": [
    {
      "path": "/api/cron/outbound-engine",
      "schedule": "0 0 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/r/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
