{
  "version": 2,
  "crons": [
    {
      "path": "/api/cron/outbound-engine",
      "schedule": "*/15 * * * *"
    }
  ],
  "rewrites": [
    { "source": "/r/(.*)", "destination": "dist/server.js" },
    { "source": "/api/(.*)", "destination": "dist/server.js" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
